#SUBSCRIBED https://raw.githubusercontent.com/openai1998/stash/main/youtube-subtitle-capture.stoverride

name: YouTube Subtitle Capture

http:
  mitm:
    - "youtube.com"
    - "*.youtube.com"
    - "video.google.com"
    - "*.googlevideo.com"

  script:
    - match: ^https:\/\/((www|m)\.youtube\.com|youtube\.com|video\.google\.com)\/api\/timedtext
      name: youtube-subtitle-capture
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
      debug: true

script-providers:
  youtube-subtitle-capture:
    url: https://raw.githubusercontent.com/openai1998/stash/main/youtube-subtitle-capture.js
    interval: 86400

tiles:
  - name: youtube-subtitle-capture
    title: YouTube 字幕抓取
    icon: play.rectangle.fill
    collapsed: true
    content: 等待抓取...
    backgroundColor: "#34C759"
    url: "https://www.youtube.com"