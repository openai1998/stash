name: YouTube Subtitle + Tile (单文件)

http:
  mitm:
    - "youtube.com"
    - "*.youtube.com"
    - "video.google.com"
    - "*.googlevideo.com"

  script:
    - match: ^https:\/\/((www|m)\.youtube\.com|youtube\.com|video\.google\.com)\/api\/timedtext
      name: youtube-subtitle
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152

script-providers:
  youtube-subtitle:
    url: https://raw.githubusercontent.com/openai1998/stash/main/youtube-subtitle.js
    interval: 86400   # 每天更新一次脚本
  # Tile 也绑定同一个 JS
  youtube-subtitle-tile:
    url: https://raw.githubusercontent.com/openai1998/stash/main/youtube-subtitle.js
    interval: 600    # Tile 每 10 分钟刷新一次

tiles:
  - name: youtube-subtitle-tile
    title: YouTube 字幕
    content: 等待抓取...
    icon: play.rectangle
    backgroundColor: "#888888"
    url: "https://www.youtube.com"