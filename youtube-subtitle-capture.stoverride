#SUBSCRIBED https://raw.githubusercontent.com/openai1998/stash/main/youtube-subtitle-capture.js

name: YouTube 字幕抓取

http:
  mitm:
    - "youtube.com"
    - "*.youtube.com"
    - "video.google.com"
    - "*.googlevideo.com"
    - "youtubei.googleapis.com"

  script:
    - match: /timedtext|youtubei|captions/
      name: youtube-subtitle-capture
      type: response
      require-body: true
      timeout: 30
      max-size: 2097152
      debug: true

script-providers:
  youtube-subtitle-capture:
    url: https://raw.githubusercontent.com/openai1998/stash/main/youtube-subtitle-capture.js
    interval: 86400  # 每天更新一次脚本