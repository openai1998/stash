name: YouTube Subtitle Capture

http:
  mitm:
    - "www.youtube.com"
    - "*.youtube.com"
    - "video.google.com"

  script:
    - match: ^https:\/\/(www\.youtube\.com|video\.google\.com)\/api\/timedtext
      name: youtube-subtitle-capture
      type: response
      require-body: true
      timeout: 10
      max-size: 2097152
      debug: true

script-providers:
  youtube-subtitle-capture:
    url: https://raw.githubusercontent.com/openai1998/stash/main/youtube-subtitle-capture.js
    interval: 86400
