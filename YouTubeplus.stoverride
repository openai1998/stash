name: YouTube 去广告精准版
desc: 屏蔽 YouTube 广告和统计请求，支持 PiP / 后台播放，保持主视频流正常
author: Maasea
homepage: https://yfamilys.com
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

http:
  mitm:
    - "*.googlevideo.com"
    - "www.youtube.com"
    - "s.youtube.com"
    - "youtubei.googleapis.com"

  script:
    # 拦截主要 API，用于广告分析或替换逻辑
    - match: /youtubei\.googleapis\.com\/youtubei\/v1\//
      name: YouTubeAdBlocker
      type: response
      require-body: true
      binary-mode: true
      timeout: 10

  rewrite:
    # === 广告屏蔽，只拦截明确广告 URL ===
    - ^https?:\/\/[\w-]+\.googlevideo\.com\/.*dclk_video_ads.* - reject-200
    - ^https?:\/\/[\w-]+\.googlevideo\.com\/.*&ad=.* - reject-200
    - ^https?:\/\/[\w-]+\.googlevideo\.com\/.*&oad=.* - reject-200

    # === 广告统计和 tracking ===
    - ^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200
    - ^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject-200
    - ^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject-200

    # === Shorts / Reels 广告 ===
    - ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/reel\/reel_watch_sequence.* - reject-200

script-providers:
  YouTubeAdBlocker:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js
    interval: 86400